# Set whichever keys you have — providers are tried in LLM_PROVIDER_ORDER automatically.
# You need at least ONE key.

# Free tier (try first)
GROQ_API_KEY=          # console.groq.com           — free, 12k TPM

# Paid fallbacks (add any you have; cheapest listed first)
ANTHROPIC_API_KEY=     # console.anthropic.com      — ~$0.003/run (claude-haiku-4-5)
MISTRAL_API_KEY=       # console.mistral.ai         — ~$0.002/run
TOGETHER_API_KEY=      # api.together.ai            — ~$0.010/run
OPENAI_API_KEY=        # platform.openai.com        — ~$0.003/run (gpt-4o-mini)

# Provider priority (comma-separated; only providers with keys set are active)
# Default: groq,anthropic,mistral,together,openai
# LLM_PROVIDER_ORDER=groq,anthropic,mistral,together,openai

# Residential proxy — the most reliable fix for YouTube bot-detection on cloud servers.
# Webshare.io free tier (10 proxies, 1GB/month) is enough for a demo.
# Format: http://username:password@proxy-host:port
# YTDLP_PROXY=http://user:pass@proxy.webshare.io:80

# YouTube cookies — fallback if no proxy, less reliable on datacenter IPs.
# Option A — base64-encoded cookies string (works on any host, no secret files needed):
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
#   Mac/Linux:  base64 -w 0 cookies.txt
# YTDL_COOKIES_B64=<paste base64 string here>
#
# Option B — path to cookies.txt on disk (local dev or Render paid plan):
# YTDL_COOKIES_FILE=cookies.txt
